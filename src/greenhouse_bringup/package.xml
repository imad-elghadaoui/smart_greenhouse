<?xml version="1.0"?>
<package format="3">
  <name>greenhouse_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and default configuration for the smart greenhouse.</description>
  <maintainer email="imad.elghadaoui@usmba.ac.ma">imad-elghadaoui</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>greenhouse_common</exec_depend>
  <exec_depend>greenhouse_control</exec_depend>
  <exec_depend>greenhouse_monitor</exec_depend>
  <exec_depend>greenhouse_sensors</exec_depend>
